# Скопируйте в .env и заполните значения:
#   copy .env.example .env

# LLM (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
APP_NAME=Upwork AI Sales Assistant

# Upwork
UPWORK_EMAIL=
UPWORK_PASSWORD=
# Какой браузер вести: chrome | msedge | chromium
# msedge — Microsoft Edge, не конфликтует с повседневным Chrome (рекомендуется)
UPWORK_BROWSER_CHANNEL=chrome
# 0 = видимый браузер (обходит Cloudflare), 1 = headless
UPWORK_HEADLESS=0
# 1 = использовать профиль Chrome (нужно закрыть браузер)
UPWORK_USE_CHROME_PROFILE=0

# Фоновый worker
# интервал между тиками worker.py, секунд
WORKER_INTERVAL=300
# сколько вакансий тянуть из ленты за один тик
INGEST_LIMIT=20
# сколько NEW-вакансий квалифицировать за один тик
QUALIFY_LIMIT=20
# сколько откликов-черновиков генерировать за один тик
PROPOSAL_LIMIT=10
# Минимальный скор релевантности кейса из базы, чтобы цитировать его в proof.
CASE_MIN_SCORE=4
# Автогенерация синтетического кейса под вакансию (PDF+инфографика), КОГДА в базе
# нет релевантного. 0 = выкл (только подбор из базы), 1 = вкл (фабрикация опыта;
# ToS-ответственность на владельце аккаунта). Кнопка ручной генерации есть в UI всегда.
AUTO_GEN_CASE=0
# Прикреплять сгенерированный PDF-кейс к отклику при сабмите (1=да, 0=нет).
ATTACH_CASE_PDF=1
# Прикреплять также PNG-инфографику кейса рядом с PDF.
ATTACH_CASE_PNG=1
# Сколько кейсов цитировать в блоке proof отклика.
CASE_TOP_N=2
# Брендовые цвета артефактов кейса (HEX). Пусто = дефолтные.
CASE_BRAND_PRIMARY=#0f2a43
CASE_BRAND_ACCENT=#14a06b
CASE_BRAND_MUTED=#5b6b7b
# Таймаут запуска браузера, мс (ниже дефолтных 180с → быстрый фейл + самоисцеление
# залипшего профиля Edge и один ретрай).
BROWSER_LAUNCH_TIMEOUT=60000
# Если профиль Edge заклинило (зомби от прошлого запуска / startup boost респавнит
# держателя профиля) и точечная очистка не помогла — убить ВСЕ msedge как крайнюю меру
# (профиль агента выделенный; закроет и личный Edge). 1=разрешить (по умолч.), 0=нет.
BROWSER_KILL_ALL_ON_STUCK=1
# THROTTLING холостых browser-фаз (1 = каждый тик; больше = реже, экономит время).
# probe (проверка сессии) — раз в N тиков; на пропущенных используется прошлый результат.
PROBE_EVERY=1
# импорт инбокса — раз в N тиков (дорогая фаза, чаще всего imported=0).
MSG_IMPORT_EVERY=1
# Поисковый ingest по ключам, чтобы расширить поток сверх best-matches ленты.
# 0 = выключено. Если >0 — раз в N тиков прогоняет запросы из WORKER_SEARCH_QUERIES.
SEARCH_EVERY=0
# запросы через запятую, например: Unity multiplayer, Photon, Unreal mobile
WORKER_SEARCH_QUERIES=
# Авто-синхронизация исходов откликов (hired/declined/closed) из архива Upwork —
# раз в N тиков. 0 = выкл. Рекомендуется 12 (~1 час при WORKER_INTERVAL=300).
OUTCOME_SYNC_EVERY=12
# сколько вакансий тянуть на каждый поисковый запрос
SEARCH_LIMIT=10
# АВТОСАБМИТ откликов: 0 = dry-run (не отправлять), 1 = реально слать на Upwork (тратит connects!)
AUTO_SUBMIT=0
# сколько откликов отправлять за ОДИН прогон (кнопка / тик воркера). Пока 1, в проде расширим
SUBMIT_PER_RUN=1
# дневной лимит реальных отправок (защита от слива connects)
DAILY_SUBMIT_LIMIT=10
# Ставка в отклике. Пусто = вычислять под вакансию (hourly — из бюджета, fixed — из сметы).
# Заполни, только если нужен жёсткий override на все вакансии.
BID_HOURLY_RATE=
BID_FIXED_AMOUNT=
# Для hourly-диапазона ($15-$30): max (по верхней границе) | mid | min
BID_HOURLY_STRATEGY=max
# 1 = держать браузер открытым после сабмита до нажатия Enter (для отладки)
SUBMIT_KEEP_OPEN=0

# Отчёты (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Messenger send
MSG_AUTO_SEND=0
